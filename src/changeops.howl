(cli_app
  (let (proposal_path (cli_args 0))
    (if (= proposal_path "")
      (do
        (stderr "usage: changeops <proposal.json> [evidence...]")
        (exit 2))
      (try_let (content_bytes (read_file proposal_path))
        (catch err
          (do
            (stderr "Failed to read proposal file")
            (exit 3)))
        (let (content (bytes_to_string content_bytes))
          (try_let (proposal (parse_json Proposal content))
            (catch err
              (do
                (stderr "Failed to parse proposal")
                (exit 3)))
            (let (action (map_get proposal "action"))
              (do
                (if (is_nil action)
                  (set action "unknown")
                )
                (let (repo (map_get proposal "repo"))
                  (do
                    (if (is_nil repo)
                      (set repo "unknown")
                    )
                    (let (reason (map_get proposal "reason"))
                      (do
                        (if (is_nil reason) (set reason ""))
                        (let (ev_repo "")
                          (let (ev_branch "")
                            (let (ev_revision "")
                              (let (ev_current_revision "")
                                (let (ev_working_tree "")
                                  (let (ev_tests "")
                                    (let (ev_build "")
                                      (let (ev_approved "")
                                        (let (ev_candidate_exists "")
                                          (let (ev_allowed_branches "")
                                            (let (ev_allowed_actions "")
                                              (let (risk_infra "false")
                                                (let (risk_deps "false")
                                                  (let (risk_ci "false")
                                                    (let (ev_remote_head "")

                                                      (let (ev_current_remote_head "")

                                                        (let (ev_local_remote_match "false")

                                                          (let (ev_ci_status "")

                                                            (do
                                                          (for arg (cli_args)
                                                        (let (parts (str_split arg "="))
                                                    (let (key "")
                                                      (let (val "")
                                                        (let (i 0)
                                                          (do
                                                            (for p parts
                                                              (do
                                                                (if (= i 0) (set key p))
                                                                (if (= i 1) (set val p))
                                                                (set i (+ i 1))))
                                                            (if (= key "repo") (set ev_repo val))
                                                            (if (= key "branch") (set ev_branch val))
                                                            (if (= key "revision") (set ev_revision val))
                                                            (if (= key "current_revision") (set ev_current_revision val))
                                                            (if (= key "working_tree") (set ev_working_tree val))
                                                            (if (= key "tests") (set ev_tests val))
                                                            (if (= key "build") (set ev_build val))
                                                            (if (= key "approved") (set ev_approved val))
                                                            (if (= key "candidate_exists") (set ev_candidate_exists val))
                                                            (if (= key "allowed_branches") (set ev_allowed_branches val))
                                                            (if (= key "allowed_actions") (set ev_allowed_actions val))
                                                            (if (= key "risk_infra") (set risk_infra val))
                                                            (if (= key "risk_deps") (set risk_deps val))
                                                            (if (= key "risk_ci") (set risk_ci val))

                                                            (if (= key "remote_head") (set ev_remote_head val))

                                                            (if (= key "current_remote_head") (set ev_current_remote_head val))

                                                            (if (= key "local_remote_match") (set ev_local_remote_match val))

                                                            (if (= key "ci_status") (set ev_ci_status val))
                                                          ))))))
                                                          
                                                (let (action_allowed "false")
                                                  (let (branch_allowed "false")
                                                    (do
                                                      (for a (str_split ev_allowed_actions ",")
                                                        (if (= a action) (set action_allowed "true")))
                                                      (for b (str_split ev_allowed_branches ",")
                                                        (if (= b ev_branch) (set branch_allowed "true")))
                                                        
                                                      (let (decision "DENY")
                                                        (let (decision_reason "unknown action")
                                                          (do
                                                            (if (= action "inspect")
                                                              (do
                                                                (set decision "ALLOW")
                                                                (set decision_reason "inspection is read-only")
                                                              )
                                                            )
                                                            (if (= action "validate")
                                                              (do
                                                                (set decision "ALLOW")
                                                                (set decision_reason "validation is read-only")
                                                              )
                                                            )
                                                            (if (= decision "DENY")
                                                              (if (= action_allowed "false")
                                                                (do
                                                                  (set decision "DENY")
                                                                  (set decision_reason "action not permitted for this repository")
                                                                )
                                                                (if (= branch_allowed "false")
                                                                  (do
                                                                    (set decision "DENY")
                                                                    (set decision_reason "branch not permitted for this repository")
                                                                  )
                                                                  (do
                                                                    (if (= action "record_release_ready")
                                                                      (if (and (= ev_repo repo) (and (= ev_working_tree "clean") (and (= ev_tests "PASS") (= ev_build "PASS"))))
                                                                        (do
                                                                          (set decision "ALLOW")
                                                                          (set decision_reason "evidence is green")
                                                                        )
                                                                        (do
                                                                          (set decision "DENY")
                                                                          (set decision_reason "evidence is missing or failing")
                                                                        )
                                                                      )
                                                                    )
                                                                    (if (= action "create_release_candidate")
                                                                      (if (and (= ev_repo repo) (and (= ev_working_tree "clean") (and (= ev_tests "PASS") (= ev_build "PASS"))))
                                                                        (if (= ev_revision ev_current_revision)
                                                                          (if (or (= ev_remote_head "") (= ev_remote_head ev_current_remote_head))
                                                                            (if (= ev_approved "true")
                                                                              (do
                                                                                (set decision "ALLOW")
                                                                                (set decision_reason "all evidence valid and approved")
                                                                              )
                                                                              (do
                                                                                (set decision "REQUIRE_APPROVAL")
                                                                                (set decision_reason "approval required for release candidate")
                                                                              )
                                                                            )
                                                                            (do
                                                                              (set decision "DENY")
                                                                              (set decision_reason "STALE_REMOTE_EVIDENCE")
                                                                            )
                                                                          )
                                                                          (do
                                                                            (set decision "DENY")
                                                                            (set decision_reason "STALE_EVIDENCE")
                                                                          )
                                                                        )
                                                                        (do
                                                                          (set decision "DENY")
                                                                          (set decision_reason "evidence is missing or failing")
                                                                        )
                                                                      )
                                                                    )
                                                                    (if (= action "create_github_draft_release")
                                                                      (if (= ev_candidate_exists "true")
                                                                        (if (= ev_revision ev_current_revision)
                                                                          (if (or (= ev_remote_head "") (= ev_remote_head ev_current_remote_head))
                                                                            (if (= ev_approved "true")
                                                                              (do
                                                                                (set decision "ALLOW")
                                                                                (set decision_reason "all evidence valid and approved")
                                                                              )
                                                                              (do
                                                                                (set decision "REQUIRE_APPROVAL")
                                                                                (set decision_reason "approval required for github release")
                                                                              )
                                                                            )
                                                                            (do
                                                                              (set decision "DENY")
                                                                              (set decision_reason "STALE_REMOTE_EVIDENCE")
                                                                            )
                                                                          )
                                                                          (do
                                                                            (set decision "DENY")
                                                                            (set decision_reason "STALE_EVIDENCE")
                                                                          )
                                                                        )
                                                                        (do
                                                                          (set decision "DENY")
                                                                          (set decision_reason "local candidate does not exist")
                                                                        )
                                                                      )
                                                                    )
                                                                    (if (= action "rollback_release_candidate")
                                                                      (if (= ev_candidate_exists "true")
                                                                        (if (= ev_approved "true")
                                                                          (do
                                                                            (set decision "ALLOW")
                                                                            (set decision_reason "rollback approved")
                                                                          )
                                                                          (do
                                                                            (set decision "REQUIRE_APPROVAL")
                                                                            (set decision_reason "approval required for rollback")
                                                                          )
                                                                        )
                                                                        (do
                                                                          (set decision "DENY")
                                                                          (set decision_reason "candidate does not exist")
                                                                        )
                                                                      )
                                                                    )
                                                                  )
                                                                )
                                                              )
                                                            )

                                                            (print "{")
                                                            (print (str_join (list "  \"decision\": \"" decision "\",") ""))
                                                            (print (str_join (list "  \"action\": \"" (to_string action) "\",") ""))
                                                            (print (str_join (list "  \"repo\": \"" (to_string repo) "\",") ""))
                                                            (print (str_join (list "  \"revision\": \"" (to_string ev_revision) "\",") ""))
                                                            (print "  \"gates\": [")
                                                            (print (str_join (list "    {\"name\": \"action_allowed\", \"status\": \"" (if (= action_allowed "true") "PASS" "FAIL") "\"},") ""))
                                                            (print (str_join (list "    {\"name\": \"branch_allowed\", \"status\": \"" (if (= branch_allowed "true") "PASS" "FAIL") "\"},") ""))
                                                            (print (str_join (list "    {\"name\": \"working_tree\", \"status\": \"" (if (= ev_working_tree "clean") "PASS" "FAIL") "\"},") ""))
                                                            (print (str_join (list "    {\"name\": \"tests\", \"status\": \"" ev_tests "\"},") ""))
                                                            (print (str_join (list "    {\"name\": \"build\", \"status\": \"" ev_build "\"}") ""))
                                                            (print "  ],")
                                                            (print (str_join (list "  \"reason\": \"" decision_reason "\"") ""))
                                                            (print "}")
                                                          )
                                                        )
                                                      )
                                                    )
                                                  )
                                                )
                                              )
                                            )
                                          )
                                        )
                                        )
                                      )
                                    )
                                  )
                                )
                              )
                            )
                          )
                        )
                      )
                    )
                  )
                )
              )
            )
          )
        )
      )
    )
  )
)
))))))
